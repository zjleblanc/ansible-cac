---
# https://ansible-lint.readthedocs.io/configuring/
profile: production

exclude_paths:
  - "**/*secrets.yml"
  - .cache/
  - .cursor/
  - .git/
  - .github/
  - .pre-commit-config.yaml
  - assets/
  - docs/
  - scripts/
  - staging/
  - utils/

kinds:
  - playbook: "pb_*.yml"
  - vars: "config/**/*.yml"
  - vars: "vars/**/*.yml"

skip_list:
  - risky-file-permissions
warn_list: []
